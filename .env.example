# Maritime Oil-Spill Attribution Intelligence (SIH26143)
# Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File Storage & Cache Locations
DEFAULT_DATA_DIR=data/cases
SAR_CACHE_DIR=data/sar
REPORT_OUTPUT_DIR=docs

# Physical Simulation Defaults
DEFAULT_PARTICLE_COUNT=1000
DEFAULT_DIFFUSIVITY_M2_S=2.5
DEFAULT_LEEWAY_FACTOR=0.03
